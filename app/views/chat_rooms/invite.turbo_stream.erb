<%= turbo_stream.replace "group-chat-item-#{@chat_room.id}" do %>
  <%= render partial: "layouts/leftSide/group_chat/group_chat_item",
             locals: { chat_room: @chat_room, current_user: current_user } %>
<% end %>
<%= turbo_stream.replace "group-invite-wrapper" do %>
  <%= render "layouts/leftSide/group_chat/group_invite_form",
             chat_room: @chat_room,
             invite_candidates: @invite_candidates,
             sorted_members: @sorted_members %>
<% end %>
