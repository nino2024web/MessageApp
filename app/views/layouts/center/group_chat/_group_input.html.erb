<div class="chat-input-container group" id="chat-chat-input">
  <form action="<%= group_messages_path %>" method="post"
        data-controller="group--group-message-form"
        data-action="submit->group--group-message-form#sendMessage">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <textarea name="group_message[content]"
              rows="2"
              class="chat-textarea"
              placeholder="メッセージを入力してください"
              required
              data-group--group-message-form-target="textarea"
              data-action="keydown->group--group-message-form#checkEnter"></textarea>
    <%= hidden_field_tag 'group_message[chat_room_id]', @chat_room.id %>
    <button type="submit" class="chat-submit-btn">送信</button>
  </form>
</div>
