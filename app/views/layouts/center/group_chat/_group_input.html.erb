<div class="chat-input-container group" id="chat-input" data-controller="submit-on-enter">
  <%= form_with model: group_message,
                url: group_messages_path,
                data: { turbo_stream: true },
                local: false,
                html: { data: { submit_on_enter_target: "form" } } do |f| %>
    <%= f.text_area :content,
                    rows: 2,
                    class: 'chat-textarea',
                    placeholder: "メッセージを入力してください",
                    data: { submit_on_enter_target: "input", action: "keydown->submit-on-enter#sendOnEnter" } %>
    <%= f.hidden_field :chat_room_id, value: chat_room.id %>
    <%= f.submit "送信", class: 'chat-submit-btn' %>
  <% end %>
</div>
