<div id="group-messages"
     class="chat-messages"
     data-controller="common--scroll"
     data-group-chat-room-id-value="<%= chat_room.id %>"
     data-common--scroll-target="append">
  <div id="group-messages-append">
    <%= render partial: "layouts/center/group_chat/group_messages",
           locals: { chat_room: @chat_room,
           group_messages: @group_messages, current_user: current_user } %>
  </div>
</div>
