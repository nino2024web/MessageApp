<div class="chat-input-container personal" id="chat-input">
  <%= form_with model: @message,
                url: messages_path(chat_id: chat.id),
                method: :post,
                local: true,
                data: {
                  controller: "personal--message-form",
                  action: "submit->personal--message-form#sendMessage"
                } do |f| %>
    <%= f.text_area :content,
                    rows: 2,
                    class: 'chat-textarea',
                    placeholder: "メッセージを入力してください",
                    data: {
                      action: "keydown->personal--message-form#checkEnter",
                      "personal--message-form-target": "textarea"
                    } %>
    <%= f.hidden_field :chat_id, value: chat.id, name: 'message[chat_id]' %>
    <%= f.submit "送信", class: 'chat-submit-btn' %>
  <% end %>
</div>
