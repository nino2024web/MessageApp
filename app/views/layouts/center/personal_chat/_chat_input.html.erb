<div class="chat-input-container personal" id="chat-input" data-controller="submit-on-enter">
  <%= form_with model: @message,
                url: messages_path(chat_id: chat.id),
                method: :post,
                data: { turbo_stream: true },
                html: { data: { submit_on_enter_target: "form" } } do |f| %>
    <%= f.text_area :content,
                    rows: 2,
                    class: 'chat-textarea',
                    placeholder: "メッセージを入力してください",
                    data: {
                      submit_on_enter_target: "input",
                      action: "keydown->submit-on-enter#sendOnEnter"
                    } %>
    <%= f.hidden_field :chat_id, value: chat.id, name: 'message[chat_id]' %>
    <%= f.submit "送信", class: 'chat-submit-btn' %>
  <% end %>
</div>
