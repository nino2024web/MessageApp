<div id="chat-messages"
     class="chat-messages"
     data-controller="personal--message common--scroll"
     data-personal--message-chat-id-value="<%= @chat.id %>"
     data-personal--message-target="messages"
     data-common--scroll-target="append">
  <% @chat.messages.each do |message| %>
    <%= render partial: 'layouts/center/personal_chat/message', locals: { message: message, current_user: current_user } %>
  <% end %>
</div>
