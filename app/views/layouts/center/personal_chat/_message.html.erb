<div class="message <%= message.user_id == current_user.id ? 'own-message' : 'other-message' %>" data-user-id="<%= message.user_id %>"
     data-id="<%= message.id %>"
     data-user-id="<%= message.user_id %>">
  <p class="content"><%= message.content %></p>
  <p class="timestamp"><%= message.created_at.strftime("%Y/%m/%d %H:%M") %></p>
</div>
