<header class="header">
  <div class="user-info">
    <span class="user-name">
      ようこそ、<%= current_user.name %> さん！
    </span>
  </div>
  <% if @chat.present? %>
    <div class="chat-title">
      <%= @chat.other_user(current_user).name %>さんとチャットしています。
    </div>
  <% elsif @chat_room.present? %>
    <div class="chat-title">
      <%= @chat_room.name %>グループでチャットしています。
    </div>
  <% end %>
  <div class="logout-button">
    <%= link_to "ログアウト", destroy_user_session_path,
            method: :delete,
            data: { turbo_method: :delete, turbo_frame: "_top" },
            class: "logout-link" %>
  </div>
</header>
