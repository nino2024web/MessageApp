<div class="left-side">
  <div class="chat-toggle-buttons">
    <%= button_to "個人チャット", personal_user_path(current_user), method: :get, class: "chat-toggle-btn" %>
    <%= button_to "グループチャット", group_user_path(current_user), method: :get, class: "chat-toggle-btn" %>
  </div>
  <h3>チャット一覧</h3>
  <%= render "layouts/leftSide/personal_chat/chat_list", all_chats: @all_chats, current_user: current_user %>
  <h3>友達リスト</h3>
  <%= render "layouts/leftSide/personal_chat/friend_list", all_friends: @all_friends %>
  <h3>友達リクエスト</h3>
  <%= render "layouts/leftSide/personal_chat/friend_requests", friend_requests: @friend_requests %>
  <h3>友達検索</h3>
  <%= render "layouts/leftSide/personal_chat/friend_search_form" %>
  <turbo-frame id="search-results">
    <%= render "layouts/leftSide/personal_chat/search_results", search_results: @search_results %>
  </turbo-frame>
</div>
