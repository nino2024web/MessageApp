<li id="group-chat-item-<%= chat_room.id %>"
    class="chat-item"
    data-action="click->group--group-list#activate">
  <%= link_to group_user_path(current_user, chat_room_id: chat_room.id), class: "chat-link" do %>
    <div class="chat-name">
      <%= chat_room.name %>（<%= chat_room.users.count %>人）
      <span id="unread-count-group-<%= chat_room.id %>">
        <% unread = local_assigns[:unread_count] || 0 %>
        <% if unread > 0 %>
          <span class="unread-badge">未読数🔴<%= unread %></span>
        <% end %>
      </span>
    </div>
    <div class="chat-preview">
      <%= truncate(chat_room.group_messages.last&.content.to_s, length: 5) %>
    </div>
  <% end %>
</li>
