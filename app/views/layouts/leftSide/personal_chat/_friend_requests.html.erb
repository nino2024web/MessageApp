  <!-- 友達リクエスト -->
<div class="friend-requests-container"
     id="friend-requests"
     data-controller="personal--friend-request"
     data-personal--friend-request-user-id-value="<%= current_user.id %>"
     data-personal--friend-request-target="list">
  <% if friend_requests.any? %>
    <ul class="friend-requests">
      <% friend_requests.each do |request| %>
        <% next if request.status != 'pending' %>
        <li class="request-item" id="friend-request-<%= request.id %>">
          <span class="request-name"><%= request.sender.name %></span>
          <div class="request-actions"
               data-controller="personal--friend-request-buttons"
               data-personal--friend-request-buttons-id-value="<%= request.id %>"
               data-personal--friend-request-blocked-user-id-value="<%= request.sender.id %>"
               data-personal--friend-request-buttons-blocked-user-id-value="<%= request.sender.id %>">
            <button class="accept-btn" data-action="click->personal--friend-request-buttons#accept">承認</button>
            <button class="reject-btn" data-action="click->personal--friend-request-buttons#reject">拒否</button>
            <button class="block-btn" data-action="click->personal--friend-request-buttons#block">ブロック</button>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="no-chat-message">友達リクエストはありません。</p>
  <% end %>
</div>
