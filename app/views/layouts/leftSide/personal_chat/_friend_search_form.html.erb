<div data-controller="personal--friend-search">
  <%= form_with url: search_users_path,
                method: :post,
                html: {
                  class: "search_bar",
                  data: {
                    "personal--friend-search-target" => "form",
                    "action" => "submit->personal--friend-search#search"
                  }
                } do |f| %>
    <%= f.text_field :name, placeholder: "名前で検索", class: "search-input" %>
    <%= f.submit "検索", class: "search-button", data: { action: "click->personal--friend-search#search" } %>
  <% end %>
  <div id="search-results" data-personal--friend-search-target="results">
    <%= render "layouts/leftSide/personal_chat/search_results", search_results: @search_results || [] %>
  </div>
</div>
