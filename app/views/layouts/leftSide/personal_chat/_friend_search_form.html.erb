<div data-controller="friend-search">
  <%= form_with url: search_users_path,
    method: :post,
    local: true,
    data: {
      action: "submit->friend-search#search",
      friend_search_target: "form"
    },
    html: {
      class: "search_bar"
    } do |f| %>
    <%= f.text_field :name, placeholder: "名前で検索", class: "search-input" %>
    <%= f.submit "検索", class: "search-button", data: { action: "click->friend-search#search" } %>
  <% end %>
  <div id="search-results" data-friend-search-target="results">
    <%= render "layouts/leftSide/personal_chat/search_results", search_results: @search_results %>
  </div>
</div>
