<!-- メッセージ一覧全体（初期ロード時） -->
<turbo-stream action="append" target="chat-messages-append">
  <template>
    <%= render partial: "layouts/center/personal_chat/message", formats: :html, locals: { message: @saved_message, current_user: current_user } %>
  </template>
</turbo-stream>
<turbo-stream action="append" target="chat-messages-append">
  <template>
    <%= render partial: "layouts/center/personal_chat/chat_messages", formats: :html, locals: { messages: @chat.messages.includes(:user), current_user: current_user } %>
  </template>
</turbo-stream>
<!-- 新着メッセージ追加（append） -->
<turbo-stream action="replace" target="chat-input">
  <template>
    <%= render partial: "layouts/center/personal_chat/chat_input", formats: :html, locals: { chat: @chat, message: @message } %>
  </template>
</turbo-stream>
